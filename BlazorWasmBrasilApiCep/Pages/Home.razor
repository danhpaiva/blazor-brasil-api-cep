@page "/"
@using System.Net.Http.Json
@using BlazorWasmBrasilApiCep.Models
@inject HttpClient Http

<PageTitle>Consulta CEP - BrasilAPI</PageTitle>

<h1>Consulta de CEP com Blazor WebAssembly</h1>

<div class="row mb-3">
    <div class="col-md-4">
        <label for="cepInput" class="form-label">Digite o CEP:</label>
        <input id="cepInput" class="form-ch form-control" @bind="cepDigitado" placeholder="Ex: 01001000"
               maxlength="8" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary w-100" @onclick="ConsultarCep" disabled="@carregando">
            @(carregando ? "Buscando..." : "Consultar")
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger" role="alert">
        @mensagemErro
    </div>
}

@if (endereco != null)
{
    <div class="card mt-4 shadow-sm">
        <div class="card-body">
            <h3 class="card-title text-success">Endereço Encontrado</h3>
            <p><strong>CEP:</strong> @endereco.cep</p>
            <p><strong>Logradouro:</strong> @endereco.street</p>
            <p><strong>Bairro:</strong> @endereco.neighborhood</p>
            <p><strong>Cidade:</strong> @endereco.city (@endereco.state)</p>
            <p><strong>Serviço:</strong> @endereco.service</p>
            
            @if (endereco.ibge != null)
            {
                <hr />
                <h5 class="text-muted">Dados do IBGE</h5>
                <p><strong>Cidade IBGE:</strong> @endereco.ibge.city</p>
                <p><strong>Estado IBGE:</strong> @endereco.ibge.state</p>
            }
        </div>
    </div>
}

@code {
    private string cepDigitado = string.Empty;
    private Cep? endereco;
    private string? mensagemErro;
    private bool carregando = false;

    private async Task ConsultarCep()
    {
        // Limpa estados anteriores
        mensagemErro = null;
        endereco = null;

        // Validação simples
        var cepLimpo = new string(cepDigitado.Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(cepLimpo) || cepLimpo.Length != 8)
        {
            mensagemErro = "Por favor, digite um CEP válido com 8 dígitos.";
            return;
        }

        carregando = true;

        try
        {
            // Faz a requisição GET para a BrasilAPI utilizando o HttpClient injetado
            endereco = await Http.GetFromJsonAsync<Cep>($"api/cep/v1/{cepLimpo}");
        }
        catch (HttpRequestException)
        {
            mensagemErro = "CEP não encontrado ou erro na requisição com a BrasilAPI.";
        }
        catch (Exception ex)
        {
            mensagemErro = $"Ocorreu um erro inesperado: {ex.Message}";
        }
        finally
        {
            carregando = false;
        }
    }
}